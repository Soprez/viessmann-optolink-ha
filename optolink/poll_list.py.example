"""
Vitorondens 222-F (oil) + Vitotronic 200 KO1B/KO2B (device ID 20CB) - Home Assistant poll list.

Configuration file for philippoo66/optolink-splitter (GPL-3.0). Copy it next to the
splitter as the poll list it is configured to load, after reading docs/addresses.md.
Derived from the upstream poll list format -> distributed under GPL-3.0-or-later.

SAFETY: every "number" and "select" entry below has a command_template that WRITES to
the boiler regulation. Delete those blocks if you want a strictly read-only setup.
  - 0x2323: only 1 (hot water only) and 2 (heating + hot water) are safe. NEVER send 3.
  - 0x6300 (DHW setpoint): the regulation rejects anything above 60 degC.
  - 0x2302 / 0x2303 (Spar / Party): writes are ACKed but ignored on 20CB (openv issue 377).
  - 0x2301 is read-only (write returns RetCode 3); the mode is written through 0x2323.
Poll groups: SOMETIMES = every 60 cycles (~30 min with poll_interval 30). Put a datapoint in
OFTEN if you need it fresher (the DHW charge pump 0x6513 benefits from OFTEN).
"""

poll_list = {
    "device": {
        "identifiers": ["vitorondens_222f"],
        "name": "Chaudiere Vitorondens",
        "model": "Vitorondens 222-F",
        "manufacturer": "Viessmann",
    },
    "node_id": "chaudiere",
    "dp_prefix": "chaudiere_",
    "poll_interval": 30,
    "poll_groups": {
        "ONCEONLY":  0,
        "ALWAYS":    1,
        "OFTEN":     5,
        "SOMETIMES": 60,
        "RARELY":    1000,
        "DEBUG":     -1,
    },
    "mqtt_delay": 0.2,
    "domains": [
        {
            "domain": "sensor",
            "unit_of_measurement": "°C",
            "device_class": "temperature",
            "state_class": "measurement",
            "suggested_display_precision": 1,
            "poll": [
                ("OFTEN",     "aussentemperatur",             0x0800, 2, 0.1, True),
                ("ALWAYS",    "kesseltemperatur",              0x0802, 2, 0.1, False),
                ("ALWAYS",    "warmwassertemperatur",          0x0804, 2, 0.1, False),
                ("OFTEN",     "abgastemperatur",               0x0808, 2, 0.1, False),
                ("SOMETIMES", "warmwassertemperatur_soll_akt", 0x6500, 2, 0.1, False),
                ("OFTEN",     "temperature_ambiante",          0x0896, 2, 0.1, True),
                ("OFTEN",     "vorlauftemperature_a1m1",       0x0810, 2, 0.1, False),
                ("OFTEN",     "vorlaufsolltemperature_a1m1",   0x2544, 2, 0.1, False),
                ("SOMETIMES", "speichertemperature_tiefpass",  0x0812, 2, 0.1, False),
            ]
        },
        {
            "domain": "sensor",
            "unit_of_measurement": "%",
            "state_class": "measurement",
            "suggested_display_precision": 0,
            "poll": [
                ("OFTEN", "brennerleistung",    0xA38F, 1, 0.5, False),
            ]
        },
        {
            "domain": "sensor",
            "unit_of_measurement": "h",
            "device_class": "duration",
            "state_class": "total_increasing",
            "suggested_display_precision": 1,
            "poll": [
                ("SOMETIMES", "betriebsstunden", 0x08A7, 4, 2.7777778e-4, False),
            ]
        },
        {
            "domain": "sensor",
            "state_class": "total_increasing",
            "icon": "mdi:counter",
            "poll": [
                ("SOMETIMES", "brennerstarts", 0x088A, 4, 1, False),
            ]
        },
        {
            "domain": "sensor",
            "entity_category": "diagnostic",
            "icon": "mdi:information-outline",
            "poll": [
                ("SOMETIMES", "brennerstoerung",     0x0884, 1, 1, False),
                ("SOMETIMES", "status",              0xA152, 2, 1, False),
                ("OFTEN",     "speicherladepumpe",   0x6513, 1, 1, False),
                ("SOMETIMES", "zirkulationspumpe",   0x6515, 2, 1, False),
            ]
        },
        {
            "domain": "sensor",
            "entity_category": "diagnostic",
            "icon": "mdi:identifier",
            "poll": [
                ("ONCEONLY", "geraetekennung", 0x00F8, 8),
            ]
        },
        {
            "domain": "sensor",
            "icon": "mdi:water-boiler",
            "entity_category": "diagnostic",
            "poll": [
                ("OFTEN", "betriebsart_2301_ro", 0x2301, 1, 1, False),
                ("OFTEN", "sparbetrieb_brut",   0x2302, 1, 1, False),
                ("OFTEN", "partybetrieb_brut",  0x2303, 1, 1, False),
            ]
        },
        {
            "domain": "binary_sensor",
            "device_class": "heat",
            "icon": "mdi:fire",
            "payload_on": "1",
            "payload_off": "0",
            "poll": [
                ("OFTEN", "zustand_1_stufe", 0x0842, 1, 1, False),
            ]
        },
        {
            "domain": "number",
            "icon": "mdi:chart-bell-curve",
            "suggested_display_precision": 1,
            "mode": "box",
            "command_topic": "%mqtt_listen%",
            "poll": [
                ("ALWAYS", "neigung", 0x27D3, 1, 0.1, False),
            ],
            "min": 0.2, "max": 3.5, "step": 0.1,
            "command_template": "{{ \"w;%DpAddr%;%Length%;\" ~ (value*10)|round|int }}",
        },
        {
            "domain": "number",
            "unit_of_measurement": "°C",
            "icon": "mdi:chart-bell-curve-cumulative",
            "mode": "box",
            "command_topic": "%mqtt_listen%",
            "poll": [
                ("ALWAYS", "niveau", 0x27D4, 1, 1, True),
            ],
            "min": -13, "max": 40, "step": 1,
            "command_template": "{{ \"w;%DpAddr%;%Length%;\" ~ value|round|int }}",
        },
        {
            "domain": "number",
            "unit_of_measurement": "°C",
            "icon": "mdi:thermometer",
            "mode": "box",
            "command_topic": "%mqtt_listen%",
            "min": 10, "max": 30, "step": 1,
            "command_template": "{{ \"w;%DpAddr%;%Length%;\" ~ value|round|int }}",
            "poll": [
                ("ALWAYS", "temp_confort", 0x2306, 1, 1, False),
                ("ALWAYS", "temp_reduite", 0x2307, 1, 1, False),
            ]
        },
        {
            "domain": "number",
            "unit_of_measurement": "°C",
            "icon": "mdi:water-thermometer",
            "mode": "box",
            "command_topic": "%mqtt_listen%",
            "min": 10, "max": 60, "step": 1,
            "command_template": "{{ \"w;%DpAddr%;%Length%;\" ~ value|round|int }}",
            "poll": [
                ("ALWAYS", "ecs_consigne", 0x6300, 1, 1, False),
            ]
        },
        {
            "domain": "select",
            "icon": "mdi:water-boiler",
            "command_topic": "%mqtt_listen%",
            "options": ["Eau chaude seule", "Eau chaude + chauffage"],
            "value_template": "{% if value == \"1\" %}Eau chaude seule{% elif value == \"2\" %}Eau chaude + chauffage{% else %}Inconnu ({{ value }}){% endif %}",
            "command_template": "{% if value == \"Eau chaude seule\" %}w;%DpAddr%;%Length%;1{% elif value == \"Eau chaude + chauffage\" %}w;%DpAddr%;%Length%;2{% endif %}",
            "poll": [
                ("ALWAYS", "betriebsart_mode", 0x2323, 1, 1, False),
            ]
        },
    ]
}
